# Public URL of the API as the browser reaches it (through the reverse proxy), with the /api prefix.
# Inlined at build time: after changing it, rebuild with ./deploy.sh.
NEXT_PUBLIC_API_URL=https://it-assets.example.com/api
# Host port the container is published on (127.0.0.1 only; point Nginx at it).
WEB_PORT=3000
